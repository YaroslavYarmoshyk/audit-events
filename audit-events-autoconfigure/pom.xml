<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.acme.audit</groupId>
        <artifactId>audit-events</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>audit-events-autoconfigure</artifactId>
    <name>audit-events-autoconfigure</name>
    <description>Stack-neutral (shared) auto-configuration for the audit events library</description>

    <dependencies>
        <dependency>
            <groupId>com.acme.audit</groupId>
            <artifactId>audit-events-core</artifactId>
        </dependency>

        <!-- Core auto-configuration + conditions -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- AOP for @Audited -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-aspects</artifactId>
        </dependency>

        <!-- @TransactionalEventListener (AFTER_COMMIT) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>

        <!-- Jackson for metadata serialization -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- ===== Optional integrations: activated only when present on the client classpath ===== -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Authentication + OAuth2 principal types read by OAuth2AuditPrincipalResolver, the default
             auditor (createdBy) resolution used by the servlet and reactive security modules. oauth2-core
             is only touched when present, so plain username/password apps need neither. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-core</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ===== Test ===== -->
        <!-- Shared test constants (TestData). Version pinned explicitly because the BOM only
             manages the main jar, not the test-jar type. -->
        <dependency>
            <groupId>com.acme.audit</groupId>
            <artifactId>audit-events-core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <!-- spring-jdbc, micrometer-core, spring-security-core and spring-security-oauth2-core above
             are 'optional' (compile scope) and therefore already on this module's own test classpath. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Java 8 date/time (LocalDateTime) Jackson support - provided by Spring Boot at runtime,
             needed here to assert the AuditEventResponse serialization format. -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Publishes the shared test fixtures (TestDataFactory / TestDataSources) as a test-jar
                 so the mvc and webflux modules can reuse them instead of duplicating principals and publishers. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
